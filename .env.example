# .env.example — Copy this to .env and fill in real values for local development.
# Never commit .env to git.

# -----------------------------------------------------------------------
# Google Sheets (required)
# -----------------------------------------------------------------------

# Spreadsheet ID from the URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Path to the service account JSON key file
# Download from Google Cloud Console → IAM & Admin → Service Accounts → Keys
GOOGLE_SERVICE_ACCOUNT=service_account.json

# -----------------------------------------------------------------------
# Facebook crawler (required)
# -----------------------------------------------------------------------

# Path to a Playwright-format cookies JSON file exported after FB login.
# Export with: playwright codegen --save-storage=fb_cookies.json facebook.com
# (log in manually during codegen, then Ctrl+C to save)
FB_COOKIE_FILE=fb_cookies.json

# Show the browser window during crawl (useful for debugging cookie issues)
# Set to "false" to run headless (default for CI)
FB_HEADLESS=true

# -----------------------------------------------------------------------
# Canary / alerting (optional — no alerts sent if unset)
# -----------------------------------------------------------------------

# Slack incoming webhook URL
# Create at: api.slack.com/apps → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Override canary thresholds (optional)
CANARY_RUNTIME_THRESHOLD_SECS=3600
CANARY_DEDUP_LOW=0.10
CANARY_DEDUP_HIGH=0.60

# -----------------------------------------------------------------------
# Platform config (optional)
# -----------------------------------------------------------------------

# Comma-separated list of platforms to crawl (default: facebook)
# ENABLED_PLATFORMS=facebook

# -----------------------------------------------------------------------
# GitHub Actions secrets reference
# -----------------------------------------------------------------------
# In CI, the above variables are set via GitHub Secrets, not .env:
#   GOOGLE_SHEETS_ID          → Repository secret
#   GOOGLE_SERVICE_ACCOUNT_JSON → Full JSON content of service_account.json
#   FB_COOKIE_JSON             → Full JSON content of fb_cookies.json
#   SLACK_WEBHOOK_URL          → Repository secret
